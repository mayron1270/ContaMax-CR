param(
    [string]$SqlServer = "(localdb)\\MSSQLLocalDB",
    [string]$DatabaseCentral = "ContaMaxCR_Central",
    [string]$DatabaseEmpresa = "ContaMaxCR_Empresa_Template",
    [string]$InstallPath = "C:\Program Files\ContaMaxCR"
)

$ErrorActionPreference = 'Stop'

Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Instalador de ContaMax-CR para Windows" -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan

New-Item -ItemType Directory -Path $InstallPath -Force | Out-Null

Write-Host "[1/3] Validando requisitos del sistema..." -ForegroundColor Yellow
Write-Host "- SQL Server: $SqlServer" -ForegroundColor Gray
Write-Host "- Ruta de instalación: $InstallPath" -ForegroundColor Gray

Write-Host "[2/3] Creando carpetas del sistema..." -ForegroundColor Yellow
$paths = @(
    "$InstallPath\bin",
    "$InstallPath\logs",
    "$InstallPath\sql",
    "$InstallPath\config"
)

foreach ($p in $paths) {
    New-Item -ItemType Directory -Path $p -Force | Out-Null
}

Write-Host "[3/3] Preparando archivos de configuración..." -ForegroundColor Yellow
$configContent = @"
{
  "ConnectionStrings": {
    "DefaultConnection": "Server=$SqlServer;Database=$DatabaseCentral;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
"@

Set-Content -Path "$InstallPath\config\appsettings.json" -Value $configContent

Write-Host "Instalación completada." -ForegroundColor Green
Write-Host "Se recomienda revisar SQL Server y ejecutar los scripts de la carpeta sql antes de iniciar el sistema." -ForegroundColor Green
Write-Host "Este script es una base para instalación en Windows y puede evolucionar a WiX/MSI o NSIS." -ForegroundColor DarkGray
