using ContaMaxCR.Core.Models;
using ContaMaxCR.Core.Services;
using ContaMaxCR.Infrastructure;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;

namespace ContaMaxCR.Api.Controllers;

[ApiController]
[Route("api/[controller]")]
public class ContabilidadController : ControllerBase
{
    private readonly ContaMaxCRDbContext _context;
    private readonly ContabilidadService _service;

    public ContabilidadController(ContaMaxCRDbContext context, ContabilidadService service)
    {
        _context = context;
        _service = service;
    }

    [HttpGet("health")]
    public IActionResult Health()
    {
        return Ok(new
        {
            estado = "ok",
            sistema = "ContaMax-CR",
            modulo = "Contabilidad",
            idioma = "es-CR"
        });
    }

    [HttpGet("empresas")]
    public async Task<IActionResult> GetEmpresas()
    {
        var empresas = await _context.Empresas.OrderBy(e => e.Nombre).ToListAsync();
        return Ok(empresas);
    }

    [HttpGet("cuentas/{empresaId:guid}")]
    public async Task<IActionResult> GetCuentas(Guid empresaId)
    {
        var cuentas = await _service.ObtenerCuentasAsync(empresaId);
        return Ok(cuentas);
    }

    [HttpPost("asiento")]
    public async Task<IActionResult> CrearAsiento([FromBody] CrearAsientoRequest request)
    {
        var resultado = await _service.CrearAsientoAsync(
            request.EmpresaId,
            request.CuentaDebitoId,
            request.CuentaCreditoId,
            request.Monto,
            request.Descripcion,
            request.Moneda);

        return Ok(resultado);
    }

    [HttpPost("ciclo-contable")]
    public async Task<IActionResult> GenerarCicloContable([FromBody] GenerarCicloRequest request)
    {
        var ciclo = await _service.GenerarCicloContableAsync(request.EmpresaId, request.Periodo);
        return Ok(ciclo);
    }

    [HttpGet("notas-financieras/{empresaId:guid}")]
    public async Task<IActionResult> ObtenerNotas(Guid empresaId, [FromQuery] string periodo)
    {
        var notas = await _service.GenerarNotasEstadoFinancieroAsync(empresaId, periodo);
        return Ok(notas);
    }
}

public record CrearAsientoRequest(
    Guid EmpresaId,
    Guid CuentaDebitoId,
    Guid CuentaCreditoId,
    decimal Monto,
    string Descripcion,
    MonedaTipo Moneda);

public record GenerarCicloRequest(Guid EmpresaId, DateTime Periodo);
